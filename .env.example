PORT=3000
NODE_ENV=development
# Require this secret in the Authorization: Bearer header for /v1 routes.
API_KEY=replace-with-a-long-random-secret

# Provider A: OpenAI or any OpenAI-compatible API.
PROVIDER_A_NAME=OpenAI
PROVIDER_A_BASE_URL=https://api.openai.com/v1
PROVIDER_A_API_KEY=
PROVIDER_A_MODEL=gpt-4.1-mini

# Provider B: another OpenAI-compatible provider (e.g. Groq, Together, OpenRouter).
PROVIDER_B_NAME=OpenRouter
PROVIDER_B_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_B_API_KEY=
PROVIDER_B_MODEL=openai/gpt-4.1-mini

DEFAULT_PROVIDER=auto
REQUEST_TIMEOUT_MS=60000
MAX_PROMPT_CHARS=24000
